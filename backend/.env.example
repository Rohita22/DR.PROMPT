# Application
DR_PROMPT_ENVIRONMENT=development
DR_PROMPT_CORS_ORIGINS=["http://localhost:3000"]

# Backend-only Groq integration. Never expose this value through NEXT_PUBLIC_* variables.
GROQ_API_KEY=your-groq-api-key
GROQ_TIMEOUT_SECONDS=30

# Backend-only PostgreSQL connection. Supabase may host this database; the application
# connects through PostgreSQL rather than a Supabase SDK.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dr_prompt

# Supabase Auth project URL used to derive the issuer and public JWKS endpoint.
# No service-role key is required by the backend authentication flow.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_JWKS_TIMEOUT_SECONDS=5
