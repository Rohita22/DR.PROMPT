# Application
DR_PROMPT_ENVIRONMENT=development
DR_PROMPT_CORS_ORIGINS=["http://localhost:3000"]

# Backend-only Groq integration. Never expose this value through NEXT_PUBLIC_* variables.
GROQ_API_KEY=your-groq-api-key
GROQ_TIMEOUT_SECONDS=30

# Reserved for future backend-only integrations. Leave empty for now.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
