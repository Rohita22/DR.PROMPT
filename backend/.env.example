# Application
DR_PROMPT_ENVIRONMENT=development
DR_PROMPT_CORS_ORIGINS=["http://localhost:3000"]

# Admin API key — required for every /api/v1/admin route.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset to disable the admin endpoint entirely.
ADMIN_API_KEY=your-admin-api-key

# Backend-only Groq integration. Never expose this value through NEXT_PUBLIC_* variables.
GROQ_API_KEY=your-groq-api-key
GROQ_TIMEOUT_SECONDS=30

# Backend-only PostgreSQL connection. Copy Supabase Connect -> Session pooler and
# change the scheme from postgresql:// to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://postgres.project-ref:password@pooler-host:5432/postgres

# Supabase Auth project URL used to derive the issuer and public JWKS endpoint.
# No publishable, secret, anon, or service-role key is required by the backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_JWKS_TIMEOUT_SECONDS=5

# APPLICATION challenges render results in headless Chromium via Playwright.
# Leave empty to use Playwright's bundled Chromium (`uv run playwright install chromium`),
# or set "chrome"/"msedge" to use an installed browser. Node.js must be on PATH.
APPLICATION_BROWSER_CHANNEL=

# APPLICATION-only resource controls. Run and Submit have independent cooldowns,
# while both share one per-user PostgreSQL advisory lock.
APPLICATION_RUN_COOLDOWN_SECONDS=10
APPLICATION_SUBMIT_COOLDOWN_SECONDS=20
APPLICATION_EXECUTION_LOCK_TIMEOUT_SECONDS=180
