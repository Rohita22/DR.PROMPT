# Public browser-safe URL for the FastAPI service. Do not put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only admin BFF settings. Never prefix ADMIN_API_KEY with NEXT_PUBLIC_.
# Use the same generated value as backend/ADMIN_API_KEY.
BACKEND_API_BASE_URL=http://localhost:8000
ADMIN_API_KEY=your-admin-api-key

# Public browser-safe Supabase project values. Use the modern sb_publishable_... key.
# Never use sb_secret_..., legacy service_role, or another backend secret here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
